<?xml version="1.0" encoding="utf-8"?>
<!-- Jetons T2 de l'application web (wwwroot/css/app.css), noms compris, pour que les écrans
     natifs ne jurent pas avec la page. Format #AARRGGBB : 86 % = DB, 10 % = 1A, 16 % = 29… -->
<resources>
    <color name="t2_nuit">#08090E</color>
    <color name="t2_texte">#FFFFFF</color>
    <!-- Jamais sur t2_verre_fort, comme sur le web. -->
    <color name="t2_texte_2">#DBFFFFFF</color>
    <color name="t2_verre">#1AFFFFFF</color>
    <color name="t2_verre_fort">#29FFFFFF</color>
    <color name="t2_filet">#24FFFFFF</color>
    <color name="t2_piste">#3DFFFFFF</color>

    <!-- t2_verre posé sur t2_nuit, en opaque : ni dialogue ni bandeau ne laissent voir dessous. -->
    <color name="t2_verre_opaque">#212226</color>

    <color name="ic_launcher_background">@color/t2_nuit</color>
</resources>
