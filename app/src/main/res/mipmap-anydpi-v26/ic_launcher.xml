<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk 26 : les icônes adaptatives couvrent toutes les versions supportées, aucun PNG de
     repli par densité n'est nécessaire. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Icônes thématisées d'Android 13+ : le système ignore la couleur et applique la sienne. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
