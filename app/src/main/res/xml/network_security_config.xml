<?xml version="1.0" encoding="utf-8"?>
<!--
  Trafic en clair autorisé, par choix : l'adresse du serveur est saisie à l'exécution, et
  <domain> n'accepte ni CIDR ni joker (« tout 192.168.0.0/16 » est inexprimable). L'application
  ne charge jamais que l'origine validée par /healthz ; le risque restant, une URL http://
  publique saisie par erreur, est traité par le dialogue d'avertissement de SetupActivity (voir
  ServerUrl.isPrivate).

  Pas de <certificates src="user" /> : cela ferait confiance aux CA installées par
  l'utilisateur, donc aux proxys d'interception. Pour une autorité personnelle, embarquer son
  certificat dans res/raw/ avec un <domain-config> dédié.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
