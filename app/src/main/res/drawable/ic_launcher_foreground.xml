<?xml version="1.0" encoding="utf-8"?>
<!--
  Même « Q » que wwwroot/favicon.svg, redessiné dans le canevas adaptatif de 108×108.

  Le lanceur peut rogner selon n'importe quelle forme de masque : seul le disque de rayon 33
  centré en (54,54) est garanti visible. Le glyphe y tient avec une marge — le bout de la queue,
  point le plus excentré, culmine à 31,9.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Boucle : cercle de rayon 19,6 tracé en deux arcs, faute de primitive <circle>. -->
    <path
        android:pathData="M 34.4,54 a 19.6,19.6 0 1,0 39.2,0 a 19.6,19.6 0 1,0 -39.2,0"
        android:strokeColor="#e94560"
        android:strokeWidth="8.4" />

    <!-- Queue : démarre à l'intérieur de la boucle et la traverse. C'est ce qui fait lire un Q
         plutôt qu'une loupe. -->
    <path
        android:pathData="M 59.6,59.6 L 73.6,73.6"
        android:strokeColor="#e94560"
        android:strokeLineCap="round"
        android:strokeWidth="8.4" />
</vector>
