<?xml version="1.0" encoding="utf-8"?>
<!-- Verre opaque cerné du filet T2 : posé sur la page, du verre translucide serait illisible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/t2_verre_opaque" />
    <stroke
        android:width="1dp"
        android:color="@color/t2_filet" />
    <corners android:radius="24dp" />
</shape>
