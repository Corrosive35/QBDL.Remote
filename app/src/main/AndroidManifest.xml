<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QobuzDLX">

        <!--
          allowBackup="false" : une restauration Auto Backup réinjecterait le cookie d'accès du
          WebView sur un nouveau téléphone, contournant l'écran de verrouillage.

          configChanges est volontairement exhaustif. Sans lui, une rotation — ou un simple
          basculement clair/sombre du système — détruit l'activité, donc le WebView, donc le
          circuit Blazor : la reconnexion se voit, et c'est le réglage qui pèse le plus sur
          l'impression de fluidité.

          launchMode="singleTask" : le raccourci « Changer de serveur » vise cette activité, et
          seul ce mode garantit que son action arrive dans onNewIntent de l'instance en cours
          plutôt que d'ouvrir un second WebView par-dessus le premier.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
