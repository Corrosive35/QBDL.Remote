<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Mise à jour intégrée (AppUpdater) : installer l'APK téléchargée, puis, sur Android 12+,
         se passer de confirmation quand l'application se met à jour elle-même. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QobuzDL">

        <!--
          allowBackup="false" : une restauration Auto Backup réinjecterait le cookie d'accès du
          WebView sur un nouveau téléphone, contournant l'écran de verrouillage.

          configChanges est volontairement exhaustif : sans lui, une rotation ou un basculement
          clair/sombre du système détruit l'activité, donc le WebView et le circuit Blazor, et
          la reconnexion se voit.

          launchMode="singleTask" : le raccourci « Changer de serveur » vise cette activité, et
          seul ce mode garantit que son action arrive dans onNewIntent de l'instance en cours
          plutôt que d'ouvrir un second WebView par-dessus le premier. Il en va de même du lien
          de retour, qui recharge le WebView en place.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Lien de retour qbdlremote://signed-in. Une connexion ouverte dans le navigateur du
              téléphone se termine sur une page du serveur, qui rouvre l'application par ce lien
              pour qu'elle se recharge. BROWSABLE permet au navigateur de l'ouvrir. Le lien ne
              transporte rien : MainActivity ignore chemin, paramètres et fragment.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="signed-in"
                    android:scheme="qbdlremote" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".UpdateStatusReceiver"
            android:exported="false" />
    </application>
</manifest>
